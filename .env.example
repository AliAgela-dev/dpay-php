# Copy to .env and fill in. .env is gitignored; this file is not.
#
# Only the live sandbox tooling under tests/sandbox/ reads these — the
# PHPUnit suite is entirely offline and needs none of them.
#
#   set -a; source .env; set +a
#   php tests/sandbox/probe.php

# Sandbox API token from the DPay dashboard. Never commit a real one.
DPAY_API_KEY=sb_tk_replace_me

# Defaults to https://dpay.ly/api/sandbox when unset. Point at
# https://dpay.ly/api only if you genuinely mean to hit production.
# DPAY_BASE_URL=https://dpay.ly/api/sandbox

# Dashboard -> Webhooks -> Reveal Secret. Needed only by
# tests/sandbox/webhook-receiver.php:
#
#   php -S 0.0.0.0:8787 tests/sandbox/webhook-receiver.php
#
# then expose :8787 over HTTPS and register that URL in the dashboard.
DPAY_WEBHOOK_SECRET=replace_me
